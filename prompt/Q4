  inquiryForm.js
  데이터 처리 로직 및 Apex 호출, 픽리스트 로드 로직을 포함합니다.


    1 import { LightningElement, track, wire } from 'lwc';
    2 import { ShowToastEvent } from 'lightning/platformShowToastEvent';
    3 import { getPicklistValues } from 'lightning/uiObjectInfoApi';
    4 import { getObjectInfo } from 'lightning/uiObjectInfoApi';
    5 import INQUIRY_OBJECT from '@salesforce/schema/Inquiry__c';
    6 import CATEGORY_FIELD from '@salesforce/schema/Inquiry__c.Category__c';
    7 import createInquiry from '@salesforce/apex/InquiryController.createInquiry';
    8
    9 export default class InquiryForm extends LightningElement {
   10     @track isLoading = false;
   11     @track categoryOptions = [];
   12
   13     // 초기화된 데이터 구조
   14     @track inquiryData = {
   15         CustomerName__c: '',
   16         Email__c: '',
   17         Phone__c: '',
   18         Category__c: '',
   19         Content__c: ''
   20     };
   21
   22     // 1. Inquiry__c 오브젝트 정보 가져오기 (기본 레코드 타입 ID 획득용)
   23     @wire(getObjectInfo, { objectApiName: INQUIRY_OBJECT })
   24     inquiryObjectInfo;
   25
   26     // 2. Category__c 픽리스트 값 동적 로드
   27     @wire(getPicklistValues, {
   28         recordTypeId: '$inquiryObjectInfo.data.defaultRecordTypeId',
   29         fieldApiName: CATEGORY_FIELD
   30     })
   31     wiredPicklistValues({ error, data }) {
   32         if (data) {
   33             this.categoryOptions = data.values;
   34         } else if (error) {
   35             console.error('Error loading picklist values:', error);
   36         }
   37     }
   38
   39     // 입력값 변경 핸들러
   40     handleInputChange(event) {
   41         const field = event.target.name;
   42         this.inquiryData[field] = event.target.value;
   43     }
   44
   45     // 폼 제출 핸들러
   46     async handleSubmit() {
   47         this.isLoading = true;
   48
   49         try {
   50             // Apex 호출
   51             const resultId = await createInquiry({ inq: this.inquiryData });
   52
   53             // 성공 알림 (US-06)
   54             this.showToast('성공', '문의가 정상적으로 접수되었습니다. (ID: ' + resultId + ')', 'success');
   55
   56             // 폼 초기화
   57             this.resetForm();
   58
   59         } catch (error) {
   60             // 에러 알림 (US-05)
   61             let message = '알 수 없는 에러가 발생했습니다.';
   62             if (error.body && error.body.message) {
   63                 message = error.body.message;
   64             }
   65             this.showToast('오류', message, 'error');
   66         } finally {
   67             this.isLoading = false;
   68         }
   69     }
   70
   71     // 폼 데이터 초기화
   72     resetForm() {
   73         this.inquiryData = {
   74             CustomerName__c: '',
   75             Email__c: '',
   76             Phone__c: '',
   77             Category__c: '',
   78             Content__c: ''
   79         };
   80     }
   81
   82     // 공통 토스트 메시지 함수
   83     showToast(title, message, variant) {
   84         this.dispatchEvent(
   85             new ShowToastEvent({
   86                 title: title,
   87                 message: message,
   88                 variant: variant
   89             })
   90         );
   91     }
   92 }

