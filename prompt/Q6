    47 export default class InquiryList extends NavigationMixin(LightningElement) { // NavigationMixin 적용
    48     @track inquiries = [];
    49     @track draftValues = []; // 초안 값 저장
    50     @track isLoading = true;
    51     @track columns = COLUMNS;
    52
    53     wiredInquiryResult;
    54
    55     @wire(getInquiryList)
    56     wiredInquiries(result) {
    57         this.wiredInquiryResult = result;
    58         const { data, error } = result;
    59
    60         if (data) {
    61             this.inquiries = data;
    62             this.isLoading = false;
    63         } else if (error) {
    64             this.showToast('에러', '데이터를 불러오는 중 오류가 발생했습니다.', 'error');
    65             this.isLoading = false;
    66         }
    67     }
    68
    69     get isDataEmpty() {
    70         return !this.isLoading && (!this.inquiries || this.inquiries.length === 0);
    71     }
    72
    73     async handleRefresh() {
    74         this.isLoading = true;
    75         try {
    76             await refreshApex(this.wiredInquiryResult);
    77         } catch (error) {
    78             this.showToast('에러', '새로고침 중 오류가 발생했습니다.', 'error');
    79         } finally {
    80             this.isLoading = false;
    81         }
    82     }
    83
    84     // 인라인 편집 저장 핸들러
    85     async handleSave(event) {
    86         const updatedFields = event.detail.draftValues;
    87
    88         try {
    89             this.isLoading = true;
    90             await updateInquiries({ data: updatedFields });
    91
    92             this.showToast('성공', '상태가 수정되었습니다.', 'success');
    93
    94             // 초안 초기화 및 데이터 갱신
    95             this.draftValues = [];
    96             await refreshApex(this.wiredInquiryResult);
    97
    98         } catch (error) {
    99             let message = '저장 중 오류가 발생했습니다.';
   100             if (error.body && error.body.message) {
   101                 message = error.body.message;
   102             }
   103             this.showToast('오류', message, 'error');
   104         } finally {
   105             this.isLoading = false;
   106         }
   107     }
   108
   109     // Row Action 핸들러
   110     handleRowAction(event) {
   111         const actionName = event.detail.action.name;
   112         const row = event.detail.row;
   113
   114         if (actionName === 'view_details') {
   115             this[NavigationMixin.Navigate]({
   116                 type: 'standard__recordPage',
   117                 attributes: {
   118                     recordId: row.Id,
   119                     objectApiName: 'Inquiry__c',
   120                     actionName: 'view'
   121                 }
   122             });
   123         }
   124     }
   125
   126     showToast(title, message, variant) {
   127         this.dispatchEvent(
   128             new ShowToastEvent({
   129                 title: title,
   130                 message: message,
   131                 variant: variant
   132             })
   133         );
   134     }
   135 }

