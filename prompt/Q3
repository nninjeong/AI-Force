   15     @AuraEnabled
   16     public static String createInquiry(Inquiry__c inq) {
   17         try {
   18             // 1. 필수값 유효성 검사 (서버 사이드 검증)
   19             validateInquiry(inq);
   20
   21             // 2. 레코드 삽입 (Bulkify 패턴 적용 가능하도록 리스트 처리)
   22             List<Inquiry__c> inquiriesToInsert = new List<Inquiry__c>{ inq };
   23             insert inquiriesToInsert;
   24
   25             return inquiriesToInsert[0].Id;
   26
   27         } catch (DmlException e) {
   28             // DML 에러 발생 시 한국어 메시지로 변환하여 반환
   29             throw new AuraHandledException('데이터 저장 중 오류가 발생했습니다: ' + e.getDmlMessage(0));
   30         } catch (Exception e) {
   31             // 기타 예외 발생 시 한국어 메시지 반환
